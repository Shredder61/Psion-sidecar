#!/bin/bash
# Safe updater for the installed Psion Sidecar application.
# Install as /usr/local/sbin/update-psion-sidecar and run with sudo.
set -Eeuo pipefail

REPO="/home/pi/Psion-sidecar"
APP="/opt/psion-sidecar"
SERVICE="psion-sidecar.service"
BACKUP_DIR="/var/backups/psion-sidecar"
REPO_USER="pi"
SOURCE_DIR=""
CROSSWORDS="$APP/crosswords"
FILES=(
    sidecar_web.py
    guardian_pi.py
    crossword_converter.py
    epoc16_index.json
    epoc32_index.json
    software_index.json
)

if [[ $EUID -ne 0 ]]; then
    echo "ERROR: Run this script with sudo, for example:"
    echo "  sudo /usr/local/sbin/update-psion-sidecar"
    exit 1
fi

for command in git python3 tar install curl runuser systemctl; do
    command -v "$command" >/dev/null 2>&1 || {
        echo "ERROR: Required command not found: $command"
        exit 1
    }
done

[[ -d "$REPO/.git" ]] || { echo "ERROR: Git checkout not found at $REPO"; exit 1; }
[[ -d "$APP" ]] || { echo "ERROR: Installed application not found at $APP"; exit 1; }
id sidecar >/dev/null 2>&1 || { echo "ERROR: Linux service account 'sidecar' does not exist."; exit 1; }
id "$REPO_USER" >/dev/null 2>&1 || { echo "ERROR: Repository owner account '$REPO_USER' does not exist."; exit 1; }

cleanup() {
    if [[ -n "$SOURCE_DIR" && -d "$SOURCE_DIR" ]]; then
        rm -rf -- "$SOURCE_DIR"
    fi
}
trap cleanup EXIT

# Ensure the writable data directory exists and its directory entry belongs to
# the service user. This does not recursively change ownership of stored files.
install -d -o sidecar -g sidecar -m 0755 "$CROSSWORDS"
chown sidecar:sidecar "$CROSSWORDS"
chmod 0755 "$CROSSWORDS"
if ! runuser -u sidecar -- test -w "$CROSSWORDS"; then
    echo "ERROR: The Sidecar service user cannot write to $CROSSWORDS"
    echo "Check the directory and its parent-directory permissions."
    exit 1
fi
echo "PASS: Crossword directory is writable by the sidecar service user."

if ! systemctl is-active --quiet "$SERVICE"; then
    echo "ERROR: $SERVICE is not running. No update attempted."
    exit 1
fi

if [[ -n "$(runuser -u "$REPO_USER" -- git -C "$REPO" status --porcelain)" ]]; then
    echo "ERROR: Git checkout has local changes."
    echo "Resolve them before updating. No application files changed."
    exit 1
fi

echo "Fetching updates from GitHub..."
runuser -u "$REPO_USER" -- git -C "$REPO" fetch origin main
SOURCE_COMMIT="$(runuser -u "$REPO_USER" -- git -C "$REPO" rev-parse origin/main)"
SOURCE_DIR="$(mktemp -d /tmp/psion-sidecar-update.XXXXXX)"
echo "Preparing source commit: ${SOURCE_COMMIT:0:12}"
runuser -u "$REPO_USER" -- git -C "$REPO" archive origin/main | tar -x -C "$SOURCE_DIR"

echo "Checking required files..."
for file in "${FILES[@]}"; do
    if [[ ! -f "$SOURCE_DIR/$file" ]]; then
        echo "ERROR: Missing $file in fetched GitHub main. No application files changed."
        exit 1
    fi
done

echo "Checking Python syntax..."
python3 -m py_compile "$SOURCE_DIR/sidecar_web.py" "$SOURCE_DIR/guardian_pi.py" "$SOURCE_DIR/crossword_converter.py"

mkdir -p "$BACKUP_DIR"
STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP="$BACKUP_DIR/application-$STAMP.tar.gz"
tar -czf "$BACKUP" -C "$APP" "${FILES[@]}"
echo "Backup: $BACKUP"

rollback() {
    trap - ERR
    UPDATE_IN_PROGRESS=0
    echo
    echo "UPDATE FAILED. Restoring the previous application files..."
    systemctl stop "$SERVICE" || true

    if ! tar -xzf "$BACKUP" -C "$APP"; then
        echo "CRITICAL: Could not restore the previous application files."
        echo "The service has been left stopped to avoid running a partial update."
        echo "Backup retained at: $BACKUP"
        exit 1
    fi

    if ! chown root:root "${FILES[@]/#/$APP/}"; then
        echo "CRITICAL: Files were extracted from the backup, but ownership could not be restored."
        echo "The service has been left stopped. Inspect ownership before restarting."
        echo "Backup retained at: $BACKUP"
        exit 1
    fi

    if systemctl start "$SERVICE"; then
        echo "Previous application files restored and service restart succeeded."
    else
        echo "WARNING: Previous application files were restored, but the service did not restart."
        echo "Inspect logs with: sudo journalctl -u $SERVICE -n 60 --no-pager"
    fi
    echo "Backup retained at: $BACKUP"
    echo "Inspect logs with: sudo journalctl -u $SERVICE -n 60 --no-pager"
    exit 1
}

trap 'if [[ "${UPDATE_IN_PROGRESS:-0}" -eq 1 ]]; then rollback; fi' ERR
UPDATE_IN_PROGRESS=1
echo "Stopping Sidecar for the update..."
systemctl stop "$SERVICE"

echo "Installing application files..."
for file in "${FILES[@]}"; do
    install -o root -g root -m 0644 "$SOURCE_DIR/$file" "$APP/$file"
done

echo "Starting Sidecar..."
if ! systemctl start "$SERVICE"; then
    rollback
fi

echo "Checking the web server..."
HEALTH_OK=0
for attempt in {1..10}; do
    if curl -fsS --max-time 3 http://127.0.0.1:8081/ >/dev/null; then
        HEALTH_OK=1
        break
    fi
    if [[ "$attempt" -lt 10 ]]; then
        sleep 2
    fi
done
if [[ "$HEALTH_OK" -ne 1 ]]; then
    rollback
fi

# Re-check after restart so the script never reports success if the service
# cannot save crossword downloads.
if ! runuser -u sidecar -- test -w "$CROSSWORDS"; then
    echo "ERROR: Sidecar started, but crossword storage is not writable."
    rollback
fi

echo
echo "SUCCESS: Sidecar updated and responding."
echo "Installed Git version: ${SOURCE_COMMIT:0:12}"
echo "Local checkout left unchanged."
echo "Crossword storage: writable by sidecar."
echo "Backup retained at: $BACKUP"
UPDATE_IN_PROGRESS=0
trap - ERR
